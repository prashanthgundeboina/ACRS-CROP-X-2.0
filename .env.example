# Permanent Administrator Bootstrapping
ADMIN_BOOTSTRAP_MOBILE=00110099
ADMIN_BOOTSTRAP_PASSWORD=Admin@2821
CROPERX_DEMO_ADMIN_MOBILE=00110099
CROPERX_DEMO_ADMIN_PASSWORD=ADMIN@2821

# Google Gemini AI Diagnostics Engine (Server-Side)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional Remote Telemetry & Earth Observation Providers
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
ISRO_BHUVAN_API_KEY=
IOT_BROKER_URL=
SOIL_TELEMETRY_API_KEY=
AGMARKNET_API_KEY=

# Persistent Storage Directory (For Render Disks or Persistent Volumes)
DATA_DIR=


