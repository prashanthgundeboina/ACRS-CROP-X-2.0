# Supabase PostgreSQL Database Authority
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Verify SMS Authentication
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
ENABLE_DEV_OTP=true

# Security & Session Configuration
SESSION_SECRET=
NODE_ENV=production
PORT=3000

# Public App Origin (Optional: Used for WebRTC QR Code reachability if behind custom proxy)
